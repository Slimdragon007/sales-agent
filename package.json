{
  "name": "slim-sales-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "audit:bundle": "npm run build && node scripts/audit-client-bundle.mjs",
    "worker:dev": "npm run build && wrangler dev",
    "deploy:preview": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@openai/agents": "0.14.1",
    "@phosphor-icons/react": "2.1.10",
    "openai": "6.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  }
}
